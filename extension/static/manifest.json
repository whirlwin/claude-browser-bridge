{
  "manifest_version": 3,
  "name": "Claude Browser Bridge",
  "version": "0.1.0",
  "description": "Lets a local Claude Code session control this browser.",
  "minimum_chrome_version": "135",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Claude Browser Bridge",
    "default_popup": "popup.html"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "userScripts",
    "declarativeNetRequest",
    "cookies",
    "history",
    "bookmarks",
    "downloads",
    "storage"
  ],
  "host_permissions": ["<all_urls>"]
}
